    "value": "## Alain Berset\nSELECT *\nwhere {\n    graph <https://swiss-elites.lod4hss.cloud/resource/> {\n    # p88459\n    ?s ?p <https://elites-suisses.lod4hss.org/resource/p69819> .\n    OPTIONAL {?p rdfs:label ?pLabel}\n}\n}\n\n",
