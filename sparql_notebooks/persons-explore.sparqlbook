  {
    "kind": 2,
    "language": "sparql",
    "value": "select *\nwhere {\n    graph <https://swiss-elites.lod4hss.cloud/resource/> {\n    ?p owl:sameAs ?uri\n    OPTIONAL {\n        ?p <https://sdhss.org/ontology/shortcuts/P9> ?pLabel\n    }\n    }\n}\nlimit 10",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nselect ?p (COUNT(*) AS ?number) ?pLabel\nwhere {\n    graph <https://swiss-elites.lod4hss.cloud/resource/> {\n    ?s ?p ?o .\n    OPTIONAL {?p rdfs:label ?pLabel}\n} \n}\nGROUP BY ?p ?pLabel\nOrder by desc(?number)",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT *\nWHERE {\n?s owl:sameAs ?o\nFILTER(contains(str(?o), 'wikida'))}\nLIMIT 10",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "select * where {\n    \n    {<https://swiss-elites.lod4hss.cloud/resource/p55864> ?p ?o .}\n    UNION\n    {?s ?p1 <https://swiss-elites.lod4hss.cloud/resource/p55864>}\n} limit 100",
    "metadata": {}
