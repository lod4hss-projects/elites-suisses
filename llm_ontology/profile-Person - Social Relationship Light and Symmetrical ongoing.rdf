                </owl:ObjectProperty>   <owl:ObjectProperty rdf:about="https://sdhss.org/ontology/social-life-core/P16">
                <rdfs:range rdf:resource="https://sdhss.org/ontology/social-life-core/C4"/>
                <rdfs:comment xml:lang="en">Associates a social relationship with the type which defines its identity</rdfs:comment>
